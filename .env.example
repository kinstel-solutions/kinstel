# Copy this file to .env.local and fill in the values you need.
# Never commit .env.local or real secrets to version control.

# --- Email (Resend) — used for inquiry, payment, and audit-lead notifications ---
RESEND_API_KEY=
EMAIL_FROM=contact@kinstel.com
EMAIL_TO=contact@kinstel.com

# --- Analytics ---
NEXT_PUBLIC_GA_ID=

# --- Razorpay (Quick Pay) — see docs/QUICK_PAY_ENV.md ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Website Audit tool (Google PageSpeed Insights) ---
# Optional. The /website-audit tool works without this key — it will call
# the public PageSpeed Insights API without authentication, which is
# subject to Google's stricter rate limits for unauthenticated requests.
# Setting a key raises those limits and is free to obtain.
# Setup guide: docs/pagespeed-api-setup.md
# PAGESPEED_API_KEY=
